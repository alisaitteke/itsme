{
  "name": "itsme-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an AI client drive your own browser through the itsme extension",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser",
    "automation",
    "chrome-extension"
  ],
  "homepage": "https://github.com/alisaitteke/itsme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alisaitteke/itsme.git",
    "directory": "packages/server"
  },
  "bugs": "https://github.com/alisaitteke/itsme/issues",
  "type": "module",
  "bin": {
    "itsme-mcp": "./dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "bundle": "tsdown && node scripts/make-mcpb.mjs",
    "typecheck": "tsc -p . --pretty false",
    "prepublishOnly": "tsdown"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@itsme/protocol": "workspace:*",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/ws": "^8.18.2",
    "tsdown": "^0.23.7",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  }
}
